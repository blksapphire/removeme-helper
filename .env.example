# Required: generate a 32-byte key with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=

# LiveRamp Privacy API credentials; keep these server-side only.
LIVERAMP_ACCOUNT_ID=
LIVERAMP_SECRET_KEY=
LIVERAMP_ORG_ID=

# Leave false until LiveRamp has approved API access and the authorized-agent workflow/consent wording have been reviewed.
LIVERAMP_AGENT_AUTHORIZED=false

PORT=8787
DATA_DIR=./data

# Optional for a frontend on another origin or an HTTPS reverse proxy.
# Set this to the exact public origin, without a trailing slash, e.g. https://app.example.com.
# Never use a wildcard.
ALLOWED_ORIGIN=
